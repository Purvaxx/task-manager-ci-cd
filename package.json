{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "A small REST API for managing tasks, built to demonstrate a full CI/CD pipeline (lint, test, Docker build, vulnerability scan, GHCR publish).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ci-cd", "express", "rest-api", "docker", "github-actions"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
